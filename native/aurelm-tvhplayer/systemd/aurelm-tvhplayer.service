[Unit]
Description=aurelm-tvhplayer: Tvheadend's channels on the head unit, for the app TVH Player
RequiresMountsFor=/var/opt
# Started by the app's connection to the socket, never at boot; it ends 10 minutes after the app's last
# request while nothing plays. Ordered before no head-unit unit, waited for by none.
Requires=aurelm-tvhplayer.socket
After=aurelm-tvhplayer.socket
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# root: the sign-in page opens (and closes again) an accept rule for its port in the unit's firewall (nft), and
# the player's frame file is made owned by nobody (mgu-render takes that). The Tvheadend client and the player
# (tvh-player) run as the tool's uid (13103) and as nobody, children of this service with its limits and LimitCORE.
# No "+" commands: every command here runs with the limits below, LimitCORE=1 included.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=TVH_STATE=/var/opt/aurelm-tvhplayer/state
ExecStartPre=-/bin/sh -c 'mkdir -p /var/opt/aurelm-tvhplayer/state && chmod 0700 /var/opt/aurelm-tvhplayer/state'
ExecStart=/usr/bin/node /var/opt/aurelm-tvhplayer/current/service.js
# however the service ended (stop, crash, kill, the out-of-memory killer): the firewall as it was
ExecStopPost=-/usr/bin/node /var/opt/aurelm-tvhplayer/current/cleanup.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=8
Nice=10
IOSchedulingClass=idle
# a channel: 2 of the unit's 4 cores at most (myAirPlay's receiver, as AirPlay Test, stuttered at 50%; the decoding is the GPU's,
# the picture's copy and the sound are ours); nice 10 keeps CarPlay and the HMI first. The frame file (6 MiB)
# and the stream's queue (40 MiB at most) count here too.
CPUQuota=200%
MemoryLimit=256M
TasksMax=48
# No core dump goes to the crash handler (which restarts the head unit for a program it does not list),
# so a crash restarts this service and never the head unit.
LimitCORE=1
StandardOutput=journal
StandardError=journal
