{
  "id": "aurelm-tvhplayer",
  "kind": "tool",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "title": "TVH Player service",
  "description": "For the app TVH Player: Tvheadend's channels on the head unit. The channel comes with one of the server's transcoding profiles (mgu-hd, mgu-sd, mgu-low: H.264 deinterlaced by the server, AAC, MPEG-TS), is decoded on the GPU into mgu-render's frame file (the app shows it while parked) and played into SmartXbar's CarLife input. Signs in once from the phone (a page on the car Wi-Fi, opened from the app's QR code); keeps the server, the user and the password (root's, 0600). Its internet goes through mgu-uplink, as uid 13103 only; the player runs as nobody.",
  "requires": {
    "mgu-deploy": "0.7.0",
    "mgu-uplink": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "internet": true,
  "uids": [
    13103
  ],
  "files": [
    {
      "path": "service.js",
      "from": "service.js",
      "mode": "0644"
    },
    {
      "path": "client.js",
      "from": "client.js",
      "mode": "0644"
    },
    {
      "path": "tvh.js",
      "from": "tvh.js",
      "mode": "0644"
    },
    {
      "path": "netx.js",
      "from": "netx.js",
      "mode": "0644"
    },
    {
      "path": "page.js",
      "from": "page.js",
      "mode": "0644"
    },
    {
      "path": "nft.js",
      "from": "nft.js",
      "mode": "0644"
    },
    {
      "path": "sockgroup.js",
      "from": "sockgroup.js",
      "mode": "0644"
    },
    {
      "path": "check.js",
      "from": "check.js",
      "mode": "0644"
    },
    {
      "path": "cleanup.js",
      "from": "cleanup.js",
      "mode": "0644"
    },
    {
      "path": "cacert.pem",
      "from": "cacert.pem",
      "mode": "0644"
    },
    {
      "path": "playback.js",
      "from": "playback.js",
      "mode": "0644"
    },
    {
      "path": "player.js",
      "from": "player.js",
      "mode": "0644"
    },
    {
      "path": "tvh-player",
      "from": "../tvh-player/build/tvh-player",
      "mode": "0755"
    },
    {
      "path": "FFMPEG-LICENSE",
      "from": "../tvh-player/build/FFMPEG-LICENSE",
      "mode": "0644"
    },
    {
      "path": "README.md",
      "from": "README.md",
      "mode": "0644"
    }
  ],
  "check": [
    "check.js"
  ],
  "deactivate": [
    "node",
    "cleanup.js"
  ],
  "crashNames": [
    "tvh-player"
  ],
  "units": [
    {
      "name": "aurelm-tvhplayer.socket",
      "from": "systemd/aurelm-tvhplayer.socket"
    },
    {
      "name": "aurelm-tvhplayer.service",
      "from": "systemd/aurelm-tvhplayer.service"
    }
  ],
  "enable": [
    {
      "unit": "aurelm-tvhplayer.socket",
      "target": "sockets.target"
    }
  ],
  "recmgr": [
    "aurelm-tvhplayer"
  ],
  "restart": [
    "aurelm-tvhplayer.service"
  ]
}
