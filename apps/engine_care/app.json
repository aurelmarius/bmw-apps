{
  "id": "engine_care",
  "title": "Engine Care",
  "description": "PHEV B48 operating hours, EV vs ICE runtime split, cold hard-start counter and true oil degradation CBS monitor",
  "version": "1.0.0",
  "vendor": "custom",
  "loggingId": "OA9C",
  "iconGlyph": "engine",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Engine Care",
      "buttons": [
        [
          "BTN_PAGE",
          "Switch Tab"
        ],
        [
          "BTN_RESET",
          "Reset Oil Service"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "maxHours",
      "label": "Max engine hours for oil change",
      "type": "number",
      "unit": "h",
      "default": 180,
      "steps": [
        120,
        150,
        180,
        200,
        250
      ]
    },
    {
      "key": "maxKm",
      "label": "Max ICE km for oil change",
      "type": "number",
      "unit": "km",
      "default": 10000,
      "steps": [
        6000,
        8000,
        10000,
        12000,
        15000
      ]
    },
    {
      "key": "coldThreshold",
      "label": "Engine is cold below",
      "type": "number",
      "unit": "°C",
      "default": 65,
      "steps": [
        50,
        60,
        65,
        70,
        75
      ]
    },
    {
      "key": "hardTorque",
      "label": "Hard torque load threshold",
      "type": "number",
      "unit": "Nm",
      "default": 150,
      "steps": [
        100,
        130,
        150,
        180,
        220
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ]
}
